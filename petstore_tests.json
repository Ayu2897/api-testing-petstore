		{
			"name": "Hapus",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Pet deleted\", () => {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Verifikasi hewan sudah hilang\r",
							"pm.test(\"Pet no longer exists\", () => {\r",
							"    pm.sendRequest({\r",
							"        url: `https://petstore.swagger.io/v2/pet/${pm.environment.get(\"pet_id\")}`,\r",
							"        method: \"GET\"\r",
							"    }, (err, res) => {\r",
							"        pm.expect(res.code).to.eql(404);  // Harus error 404\r",
							"    });\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
